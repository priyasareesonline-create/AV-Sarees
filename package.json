{
  "name": "av-sarees",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "graphql-codegen && cross-env SKIP_ENV_VALIDATION=true next build",
    "start": "node .next/standalone/server.js",
    "lint": "next lint --ignore-path .gitignore .",
    "export": "next build && next export",
    "serve:out": "serve out",
    "serve": "npm run build && npm run start",
    "cf:preflight": "npm run validate:identity && node scripts/cf-preflight.mjs",
    "cf:preflight:build": "npm run validate:identity && node scripts/cf-preflight.mjs --build-env",
    "cf:build": "npm run validate:wrangler && opennextjs-cloudflare build --config wrangler.workers.new-account.jsonc",
    "cf:dry-run": "npm run cf:build && node scripts/cf-run.mjs -- wrangler deploy --dry-run --outdir .wrangler/dry-run --config wrangler.workers.new-account.jsonc",
    "cf:secrets": "node scripts/push-worker-secrets.mjs",
    "preview": "npm run cf:build && node scripts/cf-run.mjs -- opennextjs-cloudflare preview --config wrangler.workers.new-account.jsonc",
    "deploy": "npm run cf:preflight:build && npm run cf:build && node scripts/cf-run.mjs -- wrangler deploy --config wrangler.workers.new-account.jsonc",
    "deploy:new": "npm run deploy",
    "deploy:opennext": "npm run cf:preflight:build && npm run cf:build && node scripts/cf-run.mjs -- opennextjs-cloudflare deploy --config wrangler.workers.new-account.jsonc",
    "upload": "npm run cf:preflight:build && npm run cf:build && node scripts/cf-run.mjs -- wrangler versions upload --config wrangler.workers.new-account.jsonc",
    "validate:identity": "node scripts/validate-project-identity.mjs",
    "validate:identity:login": "node scripts/validate-project-identity.mjs --strict-wrangler-login",
    "validate:wrangler": "npm run validate:identity && node scripts/validate-wrangler-production.mjs wrangler.workers.new-account.jsonc",
    "validate:media-proxy": "npm run validate:identity && node scripts/validate-priya-sarees-media-proxy.mjs",
    "deploy:media-proxy": "npm run cf:preflight && node scripts/cf-run.mjs -- wrangler deploy --config workers/r2-media-proxy/wrangler.jsonc",
    "deploy:shop-edge": "npm run cf:preflight && node scripts/cf-run.mjs -- wrangler deploy --config workers/priya-sarees-shop-edge/wrangler.jsonc",
    "auth:setup": "npm run validate:identity && node scripts/setup-auth-config.mjs",
    "dns:vercel": "npm run validate:identity && node --env-file=.env.local scripts/setup-vercel-dns.mjs",
    "dns:cf-proxy": "npm run validate:identity && node --env-file=.env.local scripts/setup-cf-proxy-cache.mjs",
    "auth:verify": "npm run validate:identity && node scripts/verify-auth.mjs",
    "pages:build": "cross-env SKIP_ENV_VALIDATION=true opennextjs-cloudflare build --config wrangler.jsonc && node scripts/cf-pages-postbuild.mjs",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "test": "jest",
    "format": "prettier --ignore-path .gitignore --write \"**/*.{ts,tsx,css,scss}\"",
    "coverage": "npm test --coverage --watchAll --collectCoverageFrom='src/components'",
    "db:bootstrap": "npm run validate:identity && node scripts/db-bootstrap.mjs",
    "db:bootstrap:dry": "npm run validate:identity && node scripts/db-bootstrap.mjs --dry-run",
    "db:generate": "drizzle-kit generate:pg --config=drizzle.config.ts",
    "db:push": "drizzle-kit push:pg --config=drizzle.config.ts",
    "db:setup": "npm run db:push && npm run db:seed",
    "supabase:graphql": "node scripts/setup-supabase.mjs",
    "db:pull": "drizzle-kit introspect:pg --config=drizzle.config.ts",
    "db:studio": "npx drizzle-kit studio",
    "db:seed": "tsx --env-file=.env.local ./src/lib/supabase/seed.ts",
    "db:seed-collections": "tsx --env-file=.env.local ./scripts/seed-sakthi-collections.ts",
    "db:upload-saree-images": "tsx --env-file=.env.local ./scripts/upload-saree-model-images.ts",
    "db:verify-images": "tsx --env-file=.env.local ./scripts/verify-catalog-images.ts",
    "db:migrate-testimonials": "node scripts/apply-testimonials.mjs",
    "db:migrate-testimonials-video": "node scripts/apply-testimonials-video.mjs",
    "db:migrate-payment-integrations": "node scripts/apply-payment-integrations.mjs",
    "db:migrate-payment-webhook-events": "node scripts/apply-payment-webhook-events.mjs",
    "db:migrate-seller-whatsapp-notify": "node scripts/apply-seller-whatsapp-notify.mjs",
    "db:migrate-products-draft-code": "node scripts/apply-products-draft-code.mjs",
    "db:migrate-product-discount": "node scripts/apply-product-discount.mjs",
    "db:migrate-user-addresses": "node scripts/apply-user-addresses.mjs",
    "db:setup-addresses": "node scripts/setup-supabase-addresses.mjs",
    "db:seed-testimonials": "tsx --env-file=.env.local ./scripts/seed-sakthi-testimonials.ts",
    "db:setup-velo-order-push": "node --env-file=.env.local ./scripts/setup-velo-order-push.mjs",
    "resend:dns": "node scripts/add-resend-dns-cloudflare.mjs",
    "email:dns:fix": "node scripts/cf-fix-email-dns.mjs",
    "email:dns:apply": "node scripts/apply-email-dns.mjs",
    "resend:verify-domain": "resend domains verify ef23a9b0-9145-4f59-84fc-0c3a795a06b6",
    "db:migrate-product-lifecycle": "node ./scripts/apply-product-lifecycle.mjs",
    "db:migrate-api-settings-rls": "node scripts/apply-api-settings-rls.mjs",
    "db:migrate-medias-gallery-index": "node scripts/apply-medias-gallery-index.mjs",
    "make-admin": "node scripts/make-admin.mjs",
    "db:drop": "drizzle-kit drop --config=drizzle.config.ts",
    "codegen": "graphql-codegen",
    "codegen:fetch": "node --no-warnings scripts/fetchGraphQLSchema",
    "codegen:watch": "npm run codegen -- --watch",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,css,md,ts,tsx}": "prettier --write"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.4",
