    "graphql-codegen": "^0.4.0",
    "husky": "^9.0.11",
    "i": "^0.3.7",
    "js-cookie": "^3.0.5",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.314.0",
    "nanoid": "^5.0.5",
    "next": "^15.5.20",
    "next-themes": "^0.2.1",
    "npm": "^10.4.0",
    "persist-and-sync": "^1.2.1",
    "postgres": "^3.4.3",
    "react": "18.2.0",
