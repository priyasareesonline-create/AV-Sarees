# Priya Sarees — copy to .env.local. Never commit .env.local.

# Supabase
NEXT_PUBLIC_SUPABASE_PROJECT_REF=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
DATABASE_SERVICE_ROLE=
DATABASE_URL=

# Cloudflare deploy — account-scoped API token (Workers Scripts:Edit, R2:Edit,
# Account Settings:Read). scripts/cf-run.mjs uses this instead of `wrangler login`.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Cloudflare R2 (S3-compatible)
NEXT_PUBLIC_S3_BUCKET=priya-sarees-cdn
NEXT_PUBLIC_S3_REGION=auto
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
NEXT_PUBLIC_CDN_URL=

# Image delivery: legacy (raw R2) until priya-sarees-media /cdn is live; then cloudflare
NEXT_PUBLIC_IMAGE_DELIVERY_MODE=legacy
NEXT_PUBLIC_MEDIA_CDN_ORIGIN=

# Site — set the real production origin when the domain is ready
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ORDER_ACCESS_SECRET=
CRON_SECRET=

# Optional
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend — order confirmation emails (verify domain in Resend dashboard)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Priya Sarees media worker (browser PUT → R2; required for admin uploads on Vercel)
R2_MEDIA_PROXY_URL=
R2_MEDIA_PROXY_SECRET=

# Stripe placeholders (unused if Cashfree/PhonePe only)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECERT_KEY=whsec_placeholder

# SKIP_ENV_VALIDATION=true
